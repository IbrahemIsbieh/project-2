<odoo>
    <!-- List View -->
    <record id="student_view_list" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="age"/>
                <field name="date_of_birth"/>
                <field name="address" optional="1"/>
                <field name="active"/>
                <field name="enrollment_ids"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="student_view_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="PERSONAL INFORMATION">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="date_of_birth" string="Birthday"/>
                            <field name="age"/>
                            <field name="type"/>
                        </group>
                        <group string="OTHER DETAILS">
                            <field name="address"/>
                            <field name="teacher_id" string="Teacher" groups="school_app.group_manage"/>
<!--                            <field name="active"/>-->
                        </group>
                    </group>

                    <notebook>
                        <page string="Enrolled Course">
                            <field name="enrollment_ids">
                             <list editable="bottom">
                                <field name="course_id"/>
                                <field name="grade"/>
                                <field name="enrollment_date"/>
                             </list>
                             </field>

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="student_view_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <!-- حقول البحث السريع -->
                <field name="name"/>
                <field name="phone"/>
                <field name="address"/>

                <!-- الفلاتر (Filters) -->
                <filter name="filter_active" string="Active Students" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived Students" domain="[('active', '=', False)]"/>

                <separator/>

                <!-- التجميع حسب العنوان (Group By) -->
                <filter name="group_by_address" string="Address" context="{'group_by': 'address'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="student_view_search"/>
    </record>

    <!-- Menuitem -->
    <menuitem id="student_action_menu"
              name="Students Management"
              parent="school_student_sub_menu"
              action="action_student"/>
</odoo>