<odoo>
    <!-- List View -->
    <record id="course_view_list" model="ir.ui.view">
        <field name="name">school.course.list</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="course_view_form" model="ir.ui.view">
        <field name="name">school.course.form</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <form>
                <header>

                        <button type="object" name="action_schedule" string="Schedule" class="btn btn-primary" invisible="state!= 'draft'"/>
                        <button type="object" name="action_start" string="Start" class="btn btn-secondary" invisible="state != 'scheduled'"/>
                        <button type="object" name="action_done" string="Completed" class="btn btn-success" invisible="state != 'start'"/>
                        <button type="object" name="action_cancel" string="Cancel" class="btn btn-danger" invisible="state =='draft' or state=='done' or state == 'cancel'"/>
                        <field name="state" widget="statusbar"/>
                </header>

                <sheet>

                    <group>
                        <group string="COURSE DETAILS">
                            <field name="name" readonly="state =='done'"/>
                            <field name="active" readonly="state =='done'"/>
                        </group>
                        <group string="ADDITIONAL INFO">
                            <field name="description" readonly="state =='done'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Enrolled Course" >
                            <field name="enrollment_ids" readonly="state =='done'">
                                <list editable="bottom">
                                    <field name="student_id" />
                                    <field name="grade"/>
                                    <field name="enrollment_date"/>
                                </list>

                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="course_view_kanban" model="ir.ui.view">
        <field name="name">school.course.kanban</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <h3 class="h3 text-muted">
                                <strong><field name="name"/></strong>
                            </h3>
                            <div>
                                <field name="description"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="course_view_search" model="ir.ui.view">
        <field name="name">school.course.search</field>
        <field name="model">school.course</field>
        <field name="arch" type="xml">
            <search>
                <!-- حقول البحث السريع في شريط البحث -->
                <field name="name"/>
                <field name="description"/>

                <!-- الفلاتر (Filters) -->
                <filter name="filter_active" string="Active Courses" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived Courses" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">school.course</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="course_view_search"/>
    </record>

    <!-- Menuitem -->
    <menuitem id="course_action_menu"
              name="Courses Management"
              parent="school_student_sub_menu"
              action="action_course"/>
</odoo>