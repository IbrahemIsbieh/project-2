<odoo>
    <!-- List View -->
    <record id="enrollment_view_list" model="ir.ui.view">
        <field name="name">school.enrollment.list</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="grade"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="enrollment_view_form" model="ir.ui.view">
        <field name="name">school.enrollment.form</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="ENROLLMENT DETAILS">
                            <field name="student_id"/>
                            <field name="course_id"/>
                            <field name="enrollment_date"/>
                        </group>
                        <group string="ACADEMIC INFO">
                            <field name="phone"/>
                            <field name="grade"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="enrollment_view_kanban" model="ir.ui.view">
        <field name="name">school.enrollment.kanban</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="course_id">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <h3 class="h3 text-muted"><field name="student_id"/></h3>
                            <h3 class="h3 text-muted"><field name="grade"/></h3>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View (تصحيح الممارسات لـ Odoo 19) -->
    <record id="enrollment_view_search" model="ir.ui.view">
        <field name="name">school.enrollment.search</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <!-- حقول البحث السريع -->
                <field name="student_id"/>
                <field name="course_id"/>

                <!-- الفلاتر -->
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>

                <separator/>

                <!-- خيارات التجميع (Group By) مستقلة بدون وسم group -->
                <filter name="group_by_student" string="Student" context="{'group_by': 'student_id'}"/>
                <filter name="group_by_course" string="Course" context="{'group_by': 'course_id'}"/>
                <filter name="group_by_grade" string="Grade" context="{'group_by': 'grade'}"/>
            </search>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="enrollment_view_calendar" model="ir.ui.view">
        <field name="name">school.enrollment.calendar</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <calendar date_start="enrollment_date" color="student_id">
                <field name="student_id"/>
            </calendar>
        </field>
    </record>

    <!-- Action -->
    <record id="action_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">school.enrollment</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="search_view_id" ref="enrollment_view_search"/>
    </record>

    <!-- Menuitem -->
    <menuitem id="enrollment_action_menu"
              name="Enrollments"
              parent="school_student_sub_menu"
              action="action_enrollment"/>
</odoo>